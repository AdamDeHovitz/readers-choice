{
  "name": "readers-choice",
  "version": "1.0.0",
  "description": "Book club app",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @readers-choice/web",
    "dev:local": "scripts/dev-local.sh",
    "build": "npm run build -w @readers-choice/web",
    "start": "npm run start -w @readers-choice/web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p apps/web && tsc --noEmit -p apps/mobile && tsc --noEmit -p packages/core && tsc --noEmit -p packages/contract && tsc --noEmit -p packages/tokens",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "VITEST_INTEGRATION=1 vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:types": "scripts/db-types.sh",
    "db:types:check": "scripts/db-types.sh --check",
    "db:sql": "scripts/db-sql.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamDeHovitz/readers-choice.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AdamDeHovitz/readers-choice/issues"
  },
  "homepage": "https://github.com/AdamDeHovitz/readers-choice#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-next": "^16.0.7",
    "eslint-import-resolver-typescript": "^3.10.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "supabase": "^2.120.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
