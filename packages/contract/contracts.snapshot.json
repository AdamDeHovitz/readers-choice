    {
      "name": "themes.list",
      "kind": "query",
      "cacheKey": [
        "club",
        "<bookClubId>",
        "themes"
      ],
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "bookClubId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "themes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "createdAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "submittedBy": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "image": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "image"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "upvoteCount": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "userHasUpvoted": {
                  "type": "boolean"
                },
                "timesUsed": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "meetings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "meetingDate": {
                        "type": "string"
                      },
                      "isFinalized": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "id",
                      "meetingDate",
                      "isFinalized"
                    ],
                    "additionalProperties": false
                  }
                },
                "canDelete": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "createdAt",
                "submittedBy",
                "upvoteCount",
                "userHasUpvoted",
                "timesUsed",
                "meetings",
                "canDelete"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "themes"
        ],
        "additionalProperties": false
      }
    },
