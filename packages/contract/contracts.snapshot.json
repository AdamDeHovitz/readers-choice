{
  "keys": {
    "myClubs": [
      "me",
      "clubs"
    ],
    "connectedApps": [
      "me",
      "connectedApps"
    ],
    "clubDirectory": [
      "clubs"
    ],
    "club": [
      "club",
      "<arg1>"
    ],
    "clubMeetings": [
      "club",
      "<arg1>",
      "meetings"
    ],
    "clubThemes": [
      "club",
      "<arg1>",
      "themes"
    ]
  },
  "operations": [
    {
      "name": "clubs.approveJoinRequest",
      "kind": "mutation",
      "description": "Admit someone who asked to join a club. Club admins only.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "bookClubId",
          "userId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    {
      "name": "clubs.cancelJoinRequest",
      "kind": "mutation",
      "description": "Withdraw the user's own pending request to join a club.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "bookClubId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    {
      "name": "clubs.create",
      "kind": "mutation",
      "description": "Create a new book club with the user as its admin. Returns the new club's id.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "bookClubId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "clubs.declineJoinRequest",
      "kind": "mutation",
      "description": "Turn down a request to join a club. Club admins only. The requester isn't told, and can't ask again until a cooldown passes.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "bookClubId",
          "userId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    {
      "name": "clubs.delete",
      "kind": "mutation",
      "description": "Permanently delete a club and everything in it. Site super admins only; confirmationName must be the club's exact name.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "confirmationName": {
            "type": "string"
          }
        },
        "required": [
          "bookClubId",
          "confirmationName"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    {
      "name": "clubs.join",
      "kind": "mutation",
      "description": "Join an open club, or ask to join a club that takes requests, with an optional note to the admins. Asking again while a request is pending replaces its note.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "message": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "bookClubId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "joined",
              "requested"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "clubs.mine",
      "kind": "query",
      "description": "List the book clubs the user belongs to, most recently joined first, with each club's id and whether the user is an admin there.",
      "cacheKey": [
        "me",
        "clubs"
      ],
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "clubs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "isAdmin": {
                  "type": "boolean"
                },
                "joinedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "description",
                "isAdmin",
                "joinedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "clubs"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "clubs.removeMember",
      "kind": "mutation",
      "description": "Remove a member from a club. Admins can remove anyone; anyone can remove themselves, which leaves the club.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "bookClubId",
          "userId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    {
      "name": "clubs.setJoinPolicy",
      "kind": "mutation",
      "description": "Set who can join a club: anyone, by request, or invite only. Club admins only. Opening a club admits everyone with a pending request.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "policy": {
            "type": "string",
            "enum": [
              "invite_only",
              "request",
              "open"
            ]
          }
        },
        "required": [
          "bookClubId",
          "policy"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    {
      "name": "clubs.setMemberAdmin",
      "kind": "mutation",
      "description": "Make a club member an admin, or remove their admin role. Club admins only; the last admin can't be demoted.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "isAdmin": {
            "type": "boolean"
          }
        },
        "required": [
          "bookClubId",
          "userId",
          "isAdmin"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    {
      "name": "connectedApps.list",
      "kind": "query",
      "description": "List the apps the user has connected to their account, most recently used first.",
      "cacheKey": [
        "me",
        "connectedApps"
      ],
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "apps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "grantId": {
                  "type": "string"
                },
                "clientName": {
                  "type": "string"
                },
                "clientHost": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "scope": {
                  "type": "string"
                },
                "connectedAt": {
                  "type": "string"
                },
                "lastUsedAt": {
                  "type": "string"
                }
              },
              "required": [
                "grantId",
                "clientName",
                "clientHost",
                "scope",
                "connectedAt",
                "lastUsedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "apps"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "connectedApps.revoke",
      "kind": "mutation",
      "description": "Disconnect an app: its access stops at once and it must ask again.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "grantId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "grantId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    {
      "name": "invites.create",
      "kind": "mutation",
      "description": "Get a club's invite code, creating one if it has none. Club admins only. Anyone with the code can join at /join/<code>.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "bookClubId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "invites.deactivate",
      "kind": "mutation",
      "description": "Turn off a club's invite code so it no longer admits anyone. Club admins only.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "bookClubId",
          "code"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    {
      "name": "invites.join",
      "kind": "mutation",
      "description": "Join the club an invite code belongs to. An invite admits its holder whatever the club's join policy, and replaces any pending request.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "bookClubName": {
            "type": "string"
          }
        },
        "required": [
          "bookClubId",
          "bookClubName"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "meetings.list",
      "kind": "query",
      "description": "List a club's meetings, newest first, with dates, deadlines, theme, the chosen book and whether each is finalized. Club members only.",
      "cacheKey": [
        "club",
        "<bookClubId>",
        "meetings"
      ],
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "bookClubId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "club": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          },
          "canSchedule": {
            "type": "boolean"
          },
          "meetings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "meetingDate": {
                  "type": "string"
                },
                "nominationDeadline": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "votingDeadline": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "isFinalized": {
                  "type": "boolean"
                },
                "details": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "theme": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "selectedBook": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "author": {
                          "type": "string"
                        },
                        "coverUrl": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "description": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "pageCount": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "publishedYear": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "title",
                        "author",
                        "coverUrl",
                        "description",
                        "pageCount",
                        "publishedYear"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "meetingDate",
                "nominationDeadline",
                "votingDeadline",
                "isFinalized",
                "details",
                "theme",
                "selectedBook"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "club",
          "canSchedule",
          "meetings"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "themes.delete",
      "kind": "mutation",
      "description": "Delete a theme no meeting has used. Allowed for whoever suggested it and for club admins.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "themeId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "themeId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    {
      "name": "themes.list",
      "kind": "query",
      "description": "List every theme in a club, newest first, with upvotes, who suggested it, the meetings that used it, and whether the user may delete it. Club members only.",
      "cacheKey": [
        "club",
        "<bookClubId>",
        "themes"
      ],
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bookClubId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "bookClubId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "themes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "createdAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "submittedBy": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "image": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "image"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "upvoteCount": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "userHasUpvoted": {
                  "type": "boolean"
                },
                "timesUsed": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "meetings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "meetingDate": {
                        "type": "string"
