            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "isAdmin": {
                  "type": "boolean"
                },
                "joinedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "description",
                "isAdmin",
                "joinedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
